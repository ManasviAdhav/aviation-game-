#include <Wire.h>
#include <U8g2lib.h>

// 0.96-inch 128x64 SSD1306 I2C OLED
U8G2_SSD1306_128X64_NONAME_F_HW_I2C display(
  U8G2_R0,
  U8X8_PIN_NONE
);

const int TEMP_SENSOR_PIN = A0;

void setup() {
  Serial.begin(9600);

  display.begin();

  display.clearBuffer();
  display.setFont(u8g2_font_6x12_tf);
  display.drawStr(12, 25, "TEMPERATURE");
  display.drawStr(31, 42, "SENSOR");
  display.sendBuffer();

  delay(1500);
}

void loop() {
  // Read the LM35 sensor
  int sensorValue = analogRead(TEMP_SENSOR_PIN);

  // Convert analog value into voltage
  float voltage = sensorValue * (5.0 / 1023.0);

  // LM35 gives 10 mV for every degree Celsius
  float temperatureC = voltage * 100.0;

  // Convert Celsius to Fahrenheit
  float temperatureF = (temperatureC * 9.0 / 5.0) + 32.0;

  Serial.print("Temperature: ");
  Serial.print(temperatureC, 1);
  Serial.println(" C");

  display.clearBuffer();

  display.setFont(u8g2_font_6x12_tf);
  display.drawStr(14, 11, "TEMPERATURE SENSOR");

  // Celsius reading
  display.setFont(u8g2_font_logisoso20_tf);
  display.setCursor(15, 39);
  display.print(temperatureC, 1);

  // Degree symbol and C
  display.drawCircle(87, 24, 2);
  display.setFont(u8g2_font_10x20_tf);
  display.drawStr(92, 39, "C");

  // Fahrenheit reading
  display.setFont(u8g2_font_6x12_tf);
  display.setCursor(34, 57);
  display.print(temperatureF, 1);
  display.print(" F");

  display.sendBuffer();

  delay(500);
}

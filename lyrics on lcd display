#include <Wire.h>
#include <LiquidCrystal_I2C.h>

LiquidCrystal_I2C lcd(0x27, 16, 2);

const int buzzerPin = 7;

// Common-anode RGB LED
const int redPin = 10;
const int greenPin = 11;
const int bluePin = 12;

// Musical notes
#define NOTE_C4 262
#define NOTE_D4 294
#define NOTE_E4 330
#define NOTE_F4 349
#define NOTE_G4 392
#define NOTE_A4 440

// Twinkle Twinkle melody
const int melody[] = {
  NOTE_C4, NOTE_C4, NOTE_G4, NOTE_G4,
  NOTE_A4, NOTE_A4, NOTE_G4,

  NOTE_F4, NOTE_F4, NOTE_E4, NOTE_E4,
  NOTE_D4, NOTE_D4, NOTE_C4,

  NOTE_G4, NOTE_G4, NOTE_F4, NOTE_F4,
  NOTE_E4, NOTE_E4, NOTE_D4,

  NOTE_G4, NOTE_G4, NOTE_F4, NOTE_F4,
  NOTE_E4, NOTE_E4, NOTE_D4,

  NOTE_C4, NOTE_C4, NOTE_G4, NOTE_G4,
  NOTE_A4, NOTE_A4, NOTE_G4,

  NOTE_F4, NOTE_F4, NOTE_E4, NOTE_E4,
  NOTE_D4, NOTE_D4, NOTE_C4
};

// 4 = quarter note, 2 = half note
const int durations[] = {
  4, 4, 4, 4, 4, 4, 2,
  4, 4, 4, 4, 4, 4, 2,
  4, 4, 4, 4, 4, 4, 2,
  4, 4, 4, 4, 4, 4, 2,
  4, 4, 4, 4, 4, 4, 2,
  4, 4, 4, 4, 4, 4, 2
};

int colourNumber = 0;

void setup() {
  pinMode(buzzerPin, OUTPUT);

  pinMode(redPin, OUTPUT);
  pinMode(greenPin, OUTPUT);
  pinMode(bluePin, OUTPUT);

  rgbOff();

  lcd.init();
  lcd.backlight();

  lcd.setCursor(0, 0);
  lcd.print("Twinkle Twinkle");
  lcd.setCursor(0, 1);
  lcd.print("Starting...");
  delay(2000);
}

void loop() {
  showLyrics("Twinkle twinkle", "little star");
  playNotes(0, 7);

  showLyrics("How I wonder", "what you are");
  playNotes(7, 7);

  showLyrics("Up above the", "world so high");
  playNotes(14, 7);

  showLyrics("Like a diamond", "in the sky");
  playNotes(21, 7);

  showLyrics("Twinkle twinkle", "little star");
  playNotes(28, 7);

  showLyrics("How I wonder", "what you are");
  playNotes(35, 7);

  noTone(buzzerPin);

  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Song finished!");
  lcd.setCursor(0, 1);
  lcd.print("Playing again");

  setRGB(true, true, true);
  delay(3000);
}

void showLyrics(const char line1[], const char line2[]) {
  lcd.clear();

  lcd.setCursor(0, 0);
  lcd.print(line1);

  lcd.setCursor(0, 1);
  lcd.print(line2);
}

void playNotes(int startNote, int numberOfNotes) {
  for (int i = startNote; i < startNote + numberOfNotes; i++) {
    int noteLength = 1200 / durations[i];

    changeColour();

    tone(buzzerPin, melody[i], noteLength);

    delay(noteLength * 1.3);

    noTone(buzzerPin);
  }
}

void changeColour() {
  switch (colourNumber) {
    case 0:
      setRGB(true, false, false);    // Red
      break;

    case 1:
      setRGB(true, true, false);     // Yellow
      break;

    case 2:
      setRGB(false, true, false);    // Green
      break;

    case 3:
      setRGB(false, true, true);     // Cyan
      break;

    case 4:
      setRGB(false, false, true);    // Blue
      break;

    case 5:
      setRGB(true, false, true);     // Magenta
      break;
  }

  colourNumber++;

  if (colourNumber > 5) {
    colourNumber = 0;
  }
}

// Common-anode RGB LED: LOW = ON, HIGH = OFF
void setRGB(bool redOn, bool greenOn, bool blueOn) {
  digitalWrite(redPin, redOn ? LOW : HIGH);
  digitalWrite(greenPin, greenOn ? LOW : HIGH);
  digitalWrite(bluePin, blueOn ? LOW : HIGH);
}

void rgbOff() {
  setRGB(false, false, false);
}

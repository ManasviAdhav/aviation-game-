#include <ESP32Servo.h>

#define SERVO_PIN 7

Servo servo;

void setup() {
  Serial.begin(115200);

  servo.setPeriodHertz(50);
  servo.attach(SERVO_PIN, 500, 2400);

  Serial.println("Servo test started");
}

void loop() {
  // Move clockwise
  for (int angle = 10; angle <= 170; angle++) {
    servo.write(angle);
    delay(20);
  }

  delay(1000);

  // Move anticlockwise
  for (int angle = 170; angle >= 10; angle--) {
    servo.write(angle);
    delay(20);
  }

  delay(1000);
}

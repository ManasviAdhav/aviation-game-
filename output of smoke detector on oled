#include <Wire.h>
#include <U8g2lib.h>

// 0.96-inch 128x64 SSD1306 I2C OLED
U8G2_SSD1306_128X64_NONAME_F_HW_I2C display(
  U8G2_R0,
  U8X8_PIN_NONE
);

const int SMOKE_SENSOR_PIN = A0;

// Adjust this after checking your sensor values
const int SMOKE_THRESHOLD = 400;

int smokeValue = 0;

void setup() {
  pinMode(SMOKE_SENSOR_PIN, INPUT);

  Serial.begin(9600);

  display.begin();

  display.clearBuffer();
  display.setFont(u8g2_font_6x12_tf);

  display.drawStr(19, 20, "SMOKE DETECTOR");
  display.drawStr(25, 38, "WARMING UP...");

  display.sendBuffer();

  // Short warm-up for classroom demonstration
  delay(10000);
}

void loop() {
  smokeValue = analogRead(SMOKE_SENSOR_PIN);

  Serial.print("Smoke value: ");
  Serial.println(smokeValue);

  display.clearBuffer();
  display.setFont(u8g2_font_6x12_tf);

  display.drawStr(18, 10, "SMOKE DETECTOR");

  // Display sensor value
  display.setCursor(0, 27);
  display.print("Sensor value: ");
  display.print(smokeValue);

  // Display status
  if (smokeValue >= SMOKE_THRESHOLD) {
    display.setFont(u8g2_font_7x14B_tf);
    display.drawStr(7, 47, "SMOKE DETECTED!");

    // Warning symbol
    display.drawTriangle(59, 51, 50, 63, 68, 63);
    display.drawLine(59, 54, 59, 59);
    display.drawPixel(59, 61);
  }
  else {
    display.setFont(u8g2_font_7x14B_tf);
    display.drawStr(22, 48, "AIR IS SAFE");

    display.drawCircle(64, 58, 4);
  }

  // Sensor-level bar
  int barWidth = map(smokeValue, 0, 1023, 0, 124);
  barWidth = constrain(barWidth, 0, 124);

  display.drawFrame(1, 53, 126, 10);
  display.drawBox(3, 55, barWidth, 6);

  display.sendBuffer();

  delay(250);
}

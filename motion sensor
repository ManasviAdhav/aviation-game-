#include <Wire.h>
#include <LiquidCrystal_I2C.h>

LiquidCrystal_I2C lcd(0x27, 16, 2);

const int pirPin = 6;

// Common-anode RGB LED pins
const int redPin = 10;
const int greenPin = 11;
const int bluePin = 12;

void setup() {
  pinMode(pirPin, INPUT);

  pinMode(redPin, OUTPUT);
  pinMode(greenPin, OUTPUT);
  pinMode(bluePin, OUTPUT);

  lcd.init();
  lcd.backlight();

  // Start with RGB LED off
  rgbOff();

  lcd.setCursor(0, 0);
  lcd.print("PIR Sensor");
  lcd.setCursor(0, 1);
  lcd.print("Initializing...");

  // PIR sensor needs time to stabilize
  delay(10000);

  lcd.clear();
}

void loop() {
  int motionState = digitalRead(pirPin);

  if (motionState == HIGH) {
    // Motion detected: Red LED
    showRed();

    lcd.setCursor(0, 0);
    lcd.print("Motion Detected ");
    lcd.setCursor(0, 1);
    lcd.print("Person Nearby!  ");
  }
  else {
    // No motion: Green LED
    showGreen();

    lcd.setCursor(0, 0);
    lcd.print("No Motion       ");
    lcd.setCursor(0, 1);
    lcd.print("Area is Clear   ");
  }

  delay(200);
}

// Common-anode RGB LED: LOW = ON, HIGH = OFF

void showRed() {
  digitalWrite(redPin, LOW);
  digitalWrite(greenPin, HIGH);
  digitalWrite(bluePin, HIGH);
}

void showGreen() {
  digitalWrite(redPin, HIGH);
  digitalWrite(greenPin, LOW);
  digitalWrite(bluePin, HIGH);
}

void rgbOff() {
  digitalWrite(redPin, HIGH);
  digitalWrite(greenPin, HIGH);
  digitalWrite(bluePin, HIGH);
}

#include <WiFi.h>
#include <WebServer.h>
#include <Adafruit_NeoPixel.h>

// NeoPixel connection
#define LED_PIN 48
#define NUMPIXELS 1

Adafruit_NeoPixel pixel(
  NUMPIXELS,
  LED_PIN,
  NEO_GRB + NEO_KHZ800
);

// ESP32 Wi-Fi hotspot details
const char* ssid = "ESP32_RGB_RP";
const char* password = "12345678";

WebServer server(80);

int r = 255;
int g = 0;
int b = 0;


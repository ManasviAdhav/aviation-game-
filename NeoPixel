// Set the NeoPixel colour
void setNeoPixelColor(int red, int green, int blue) {
  for (int i = 0; i < NUMPIXELS; i++) {
    pixel.setPixelColor(
      i,
      pixel.Color(red, green, blue)
    );
  }

  pixel.show();
}


// Runs when the webpage is opened
void handleRoot() {
  server.send_P(200, "text/html", webpage);
}


// Receives RGB values from the webpage
void handleSet() {
  if (server.hasArg("r")) {
    r = constrain(server.arg("r").toInt(), 0, 255);
  }

  if (server.hasArg("g")) {
    g = constrain(server.arg("g").toInt(), 0, 255);
  }

  if (server.hasArg("b")) {
    b = constrain(server.arg("b").toInt(), 0, 255);
  }

  setNeoPixelColor(r, g, b);

  Serial.print("RGB: ");
  Serial.print(r);
  Serial.print(", ");
  Serial.print(g);
  Serial.print(", ");
  Serial.println(b);

  server.send(200, "text/plain", "NeoPixel updated");
}


// NeoPixel startup test
void testNeoPixel() {
  setNeoPixelColor(255, 0, 0);
  delay(700);

  setNeoPixelColor(0, 255, 0);
  delay(700);

  setNeoPixelColor(0, 0, 255);
  delay(700);

  setNeoPixelColor(0, 0, 0);
  delay(500);
}


void setup() {
  Serial.begin(115200);
  delay(500);

  // Activate NeoPixel
  pixel.begin();

  // Limit overall brightness
  // Range: 0 to 255
  pixel.setBrightness(100);

  pixel.clear();
  pixel.show();

  Serial.println("Testing NeoPixel...");

  testNeoPixel();

  // Start ESP32 Wi-Fi hotspot
  WiFi.softAP(ssid, password);

  Serial.println();
  Serial.println("Wi-Fi hotspot started");

  Serial.print("Wi-Fi name: ");
  Serial.println(ssid);

  Serial.print("IP address: ");
  Serial.println(WiFi.softAPIP());

  // Web server routes
  server.on("/", handleRoot);
  server.on("/set", handleSet);

  server.begin();

  Serial.println("Web server started");
  Serial.println("Open 192.168.4.1 in your browser");

  // Initial colour after startup
  setNeoPixelColor(255, 0, 0);
}


void loop() {
  server.handleClient();
}

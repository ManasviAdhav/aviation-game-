    def update_hud(self, state: ControllerState, connected: bool, warning: str) -> None:
        self.connection_label["text"] = (
            "CONTROLLER: CONNECTED" if connected else "CONTROLLER: KEYBOARD MODE"
        )
        self.connection_label["text_fg"] = (
            (0.3, 1.0, 0.35, 1) if connected else (1.0, 0.85, 0.1, 1)
        )

        self.mission_label["text"] = "MISSION: " + self.mission_instruction(state)

        display_warning = (
            "FLIGHT ACTIVE" if warning in ("NORMAL", "CONFIGURATION ACTIVE") else warning
        )
        self.warning_label["text"] = display_warning

        if warning in ("CRASH", "STALL", "OVERSPEED", "GEAR NOT DOWN"):
            self.warning_label["text_fg"] = (1.0, 0.2, 0.2, 1)
        elif warning in ("LOW FUEL", "OUT OF FUEL", "AUTOPILOT UNAVAILABLE"):
            self.warning_label["text_fg"] = (1.0, 0.85, 0.1, 1)
        else:
            self.warning_label["text_fg"] = (0.3, 1.0, 0.35, 1)

        values = [
            f"{self.speed:03.0f}",
            f"{self.altitude_agl():03.0f}",
            f"{self.heading % 360:03.0f}",
            f"{self.vertical_speed:+.1f}",
            f"{state.throttle:03.0f}%",
            f"{state.flaps:02d}",
            "DOWN" if state.gear else "UP",
            "ON" if self.autopilot_active else "OFF",
        ]

        for label, value in zip(self.instrument_labels, values):
            label["text"] = value

    # --------------------------------------------------------
    # ESP32 FEEDBACK
    # --------------------------------------------------------

    def send_feedback(
        self,
        state: ControllerState,
        warning: str,
        buzzer: int,
        vibration: int,
        green: bool,
        yellow: bool,
        red: bool,
    ) -> None:
        """
        Send the exact feedback protocol expected by your FINAL ESP32 code:

        MISSION=...;
        WARN=...;
        ALT=...;
        SPD=...;
        STATUS=...;
        VIB=milliseconds;
        BEEP=milliseconds;
        """

        if state.sender_ip is None:
            return

        if time.monotonic() - self.last_feedback_send < 0.10:
            return

        self.last_feedback_send = time.monotonic()

        mission = self.mission_instruction(state)

        # IMPORTANT:
        # Your remote treats ANY non-empty WARN field as danger.
        # Therefore normal/configuration/autopilot/checkpoint states send
        # an EMPTY WARN field.
        danger_warnings = {
            "CRASH",
            "STALL",
            "GEAR NOT DOWN",
            "OVERSPEED",
            "OUT OF FUEL",
            "LOW FUEL",
        }

        warn_text = warning if warning in danger_warnings else ""

        if self.crashed:
            status = "CRASH"
        elif self.mission_complete:
            status = "DONE"
        elif self.autopilot_active:
            status = "AUTO"
        elif self.airborne:
            status = "FLY"
        else:
            status = "READY"

        # Your ESP32 interprets VIB and BEEP as DURATION IN MILLISECONDS.
        vib_ms = 0
        beep_ms = 0

        if warning == "CRASH":
            vib_ms = 900
            beep_ms = 900

        elif warning in ("STALL", "GEAR NOT DOWN", "OVERSPEED"):
            vib_ms = 320
            beep_ms = 260

        elif warning in ("OUT OF FUEL", "LOW FUEL"):
            vib_ms = 120
            beep_ms = 140

        elif warning == "CHECKPOINT CLEARED":
            vib_ms = 100
            beep_ms = 90

        elif warning == "MISSION COMPLETE":
            vib_ms = 300
            beep_ms = 350

        # Keep mission text protocol-safe.
        mission = mission.replace(";", ",").replace("\n", " ")
        warn_text = warn_text.replace(";", ",").replace("\n", " ")

        packet = (
            f"MISSION={mission};"
            f"WARN={warn_text};"
            f"ALT={int(round(self.altitude_agl()))};"
            f"SPD={int(round(self.speed))};"
            f"STATUS={status};"
            f"VIB={vib_ms};"
            f"BEEP={beep_ms}"
        )

        try:
            feedback_socket.sendto(
                packet.encode("utf-8"),
                (state.sender_ip, FEEDBACK_PORT),
            )
        except OSError:
            pass

    # --------------------------------------------------------
    # RESET / MAIN LOOP
    # --------------------------------------------------------

    def reset_game(self) -> None:
        self.speed = 0.0
        self.vertical_speed = 0.0
        self.heading = self.takeoff_heading
        self.pitch_angle = 0.0
        self.bank_angle = 0.0
        self.fuel = 100.0
        self.rpm = 0.0

        self.airborne = False
        self.crashed = False
        self.mission_complete = False
        self.approach_gate_passed = False
        self.checkpoint_index = 0
        self.checkpoint_flash_until = 0.0
        self.checkpoint_flash_text = ""
        self.success_until = 0.0

        self.autopilot_active = False
        self.last_autopilot_request = False
        self.autopilot_rejected_until = 0.0

        self.aircraft.setPos(TAKEOFF_START)
        self.aircraft.setHpr(-self.takeoff_heading, 0, 0)

        for index, ring in enumerate(self.rings):
            if index == 0:
                ring.show()
            else:
                ring.hide()
        self.approach_ring.hide()

    def update_game(self, task: Task):
        dt = min(ClockObject.getGlobalClock().getDt(), 0.05)

        state = controller_snapshot()
        connected = controller_connected(state)
        state = self.keyboard_fallback(state, dt)

        self.update_autopilot_request(state)
        self.update_physics(state, dt)
        self.update_mission_progress()
        self.update_camera(state)

        warning, buzzer, vibration, green, yellow, red = self.warning_state(state)
        self.update_hud(state, connected, warning)
        self.send_feedback(state, warning, buzzer, vibration, green, yellow, red)

        return Task.cont

    def close_game(self) -> None:
        global network_running
        network_running = False

        try:
            feedback_socket.close()
        except OSError:
            pass

        self.userExit()



        self.crashed = False
        self.mission_complete = False
        self.approach_gate_passed = False
        self.checkpoint_index = 0
        self.checkpoint_flash_until = 0.0
        self.checkpoint_flash_text = ""
        self.success_until = 0.0

        # Camera / autopilot
        self.camera_mode = 0
        self.last_camera_counter = 0
        self.last_centre_counter = 0
        self.autopilot_active = False
        self.last_autopilot_request = False
        self.autopilot_rejected_until = 0.0

        # Feedback
        self.last_feedback_send = 0.0

        # Keyboard fallback
        self.key_map = {
            "w": False,
            "s": False,
            "a": False,
            "d": False,
            "q": False,
            "e": False,
            "arrow_up": False,
            "arrow_down": False,
        }
        self.keyboard_throttle = 0.0
        self.keyboard_flaps = 0
        self.keyboard_gear = True
        self.keyboard_autopilot = False

        self.setup_keyboard()
        self.setup_lighting()
        self.load_world()
        self.create_mission_rings()
        self.create_aircraft()
        self.create_hud()

        self.taskMgr.add(self.update_game, "update_game")

        print(f"Takeoff heading: {self.takeoff_heading:.1f} degrees")
        print(f"Landing heading: {self.landing_heading:.1f} degrees")
        print("GAME READY")

    # --------------------------------------------------------
    # INPUT
    # --------------------------------------------------------

    def setup_keyboard(self) -> None:
        for key in self.key_map:
            self.accept(key, self.set_key, [key, True])
            self.accept(key + "-up", self.set_key, [key, False])

        self.accept("escape", self.close_game)
        self.accept("r", self.reset_game)
        self.accept("c", self.change_camera)
        self.accept("g", self.toggle_keyboard_gear)
        self.accept("f", self.keyboard_flaps_up)
        self.accept("v", self.keyboard_flaps_down)
        self.accept("p", self.toggle_keyboard_autopilot)

    def set_key(self, key: str, value: bool) -> None:
        self.key_map[key] = value

    def toggle_keyboard_gear(self) -> None:
        self.keyboard_gear = not self.keyboard_gear

    def keyboard_flaps_up(self) -> None:
        self.keyboard_flaps = min(30, self.keyboard_flaps + 10)

    def keyboard_flaps_down(self) -> None:
        self.keyboard_flaps = max(0, self.keyboard_flaps - 10)

    def toggle_keyboard_autopilot(self) -> None:
        self.keyboard_autopilot = not self.keyboard_autopilot

    def keyboard_fallback(self, state: ControllerState, dt: float) -> ControllerState:
        if controller_connected(state):
            return state

        state.roll = 0.0
        state.pitch = 0.0

        if self.key_map["a"]:
            state.roll = -100.0
        if self.key_map["d"]:
            state.roll = 100.0
        if self.key_map["w"]:
            state.pitch = 100.0
        if self.key_map["s"]:
            state.pitch = -100.0

        state.rudder_left = self.key_map["q"]
        state.rudder_right = self.key_map["e"]

        if self.key_map["arrow_up"]:
            self.keyboard_throttle = min(100.0, self.keyboard_throttle + 45.0 * dt)
        if self.key_map["arrow_down"]:
            self.keyboard_throttle = max(0.0, self.keyboard_throttle - 45.0 * dt)

        state.throttle = self.keyboard_throttle
        state.flaps = self.keyboard_flaps
        state.gear = self.keyboard_gear
        state.autopilot_request = self.keyboard_autopilot
        return state

    # --------------------------------------------------------
    # WORLD + REAL AIRCRAFT
    # --------------------------------------------------------

    def setup_lighting(self) -> None:
        ambient = AmbientLight("ambient")
        ambient.setColor(LColor(0.65, 0.65, 0.68, 1))
        ambient_np = self.render.attachNewNode(ambient)
        self.render.setLight(ambient_np)

        sun = DirectionalLight("sun")
        sun.setColor(LColor(1.0, 0.97, 0.90, 1))
        sun_np = self.render.attachNewNode(sun)
        sun_np.setHpr(-35, -55, 0)
        self.render.setLight(sun_np)

    def load_world(self) -> None:
        world_path = self.models_folder / WORLD_FILE

        if not world_path.exists():
            # Small fallback for your previous filenames.
            for filename in ("aviation_world_fixed.glb", "aviation_world.glb"):
                candidate = self.models_folder / filename
                if candidate.exists():
                    world_path = candidate
                    break

        if not world_path.exists():
            raise FileNotFoundError(
                f"World not found. Put {WORLD_FILE} inside the models folder."
            )

        print("Loading Blender world...")
        print(world_path)
        self.world = self.loader.loadModel(str(world_path))

        if self.world.isEmpty():
            raise RuntimeError("The Blender world GLB could not be loaded.")

        self.world.reparentTo(self.render)
        self.world.setPos(0, 0, 0)
        self.world.setScale(1)
        print("WORLD LOADED")

    def create_aircraft(self) -> None:
        aircraft_path = self.models_folder / AIRCRAFT_FILE

        if not aircraft_path.exists():
            raise FileNotFoundError(
                f"Aircraft not found. Export your plane as {AIRCRAFT_FILE} and place it in models/."
            )

        # Physics root. All movement/camera logic uses this node.
        self.aircraft = self.render.attachNewNode("player_aircraft")
        self.aircraft.setPos(TAKEOFF_START)
        self.aircraft.setHpr(-self.takeoff_heading, 0, 0)

        print("Loading real aircraft...")
        print(aircraft_path)
        self.aircraft_model = self.loader.loadModel(str(aircraft_path))

        if self.aircraft_model.isEmpty():
            raise RuntimeError("aircraft.glb could not be loaded.")

        self.aircraft_model.reparentTo(self.aircraft)
        self.aircraft_model.setHpr(AIRCRAFT_MODEL_HEADING_OFFSET, 0, 0)

        # Automatically scale and place the model so its lowest geometry sits on Z=0
        # of the aircraft physics root.
        bounds = self.aircraft_model.getTightBounds()
        if bounds:
            minimum, maximum = bounds
            size_x = maximum.x - minimum.x
            size_y = maximum.y - minimum.y
            size_z = maximum.z - minimum.z
            largest = max(size_x, size_y, size_z)

            scale = 1.0
            if largest > 1e-6:
                scale = AIRCRAFT_TARGET_MAX_SIZE / largest

            center_x = (minimum.x + maximum.x) * 0.5
            center_y = (minimum.y + maximum.y) * 0.5

            self.aircraft_model.setScale(scale)
            self.aircraft_model.setPos(
                -center_x * scale,
                -center_y * scale,
                -minimum.z * scale,
            )

            print(f"Aircraft auto-scale: {scale:.4f}")
        else:
            self.aircraft_model.setScale(1.0)
            self.aircraft_model.setPos(0, 0, 0)

        print("AIRCRAFT LOADED")

    # --------------------------------------------------------
    # MISSION RINGS
    # --------------------------------------------------------

    def create_mission_rings(self) -> None:
        self.rings = []

        route = CHECKPOINTS + [LANDING_APPROACH_GATE, LANDING_TOUCHDOWN]

        for i, checkpoint in enumerate(CHECKPOINTS):
            next_point = route[i + 1]
            ring = make_ring(
                self.render,
                f"checkpoint_{i + 1}",
                46.0,
                checkpoint,
                next_point,
            )
            self.rings.append(ring)

        self.approach_ring = make_ring(
            self.render,
            "landing_approach_gate",
            58.0,
            LANDING_APPROACH_GATE,
            LANDING_TOUCHDOWN,
        )
        self.approach_ring.hide()

        # Only current checkpoint is visible.
        for index, ring in enumerate(self.rings):
            if index == 0:
                ring.show()
            else:
                ring.hide()

    def update_mission_progress(self) -> None:
        if self.crashed or self.mission_complete:
            return

        pos = self.aircraft.getPos(self.render)

        # Checkpoints activate after takeoff.
        if self.airborne and self.checkpoint_index < len(CHECKPOINTS):
            target = CHECKPOINTS[self.checkpoint_index]

            if distance3(pos, target) <= CHECKPOINT_RADIUS:
                cleared_number = self.checkpoint_index + 1
                self.rings[self.checkpoint_index].hide()
                self.checkpoint_index += 1

                self.checkpoint_flash_text = f"CHECKPOINT {cleared_number} CLEARED!"
                self.checkpoint_flash_until = time.monotonic() + 1.5

                if self.checkpoint_index < len(self.rings):
                    self.rings[self.checkpoint_index].show()
                else:
                    self.approach_ring.show()

        elif self.airborne and not self.approach_gate_passed:
            if distance3(pos, LANDING_APPROACH_GATE) <= APPROACH_RADIUS:
                self.approach_gate_passed = True
                self.approach_ring.hide()
                self.checkpoint_flash_text = "APPROACH GATE CLEARED - LAND NOW"
                self.checkpoint_flash_until = time.monotonic() + 2.0

    def current_target(self) -> Point3:
        if self.checkpoint_index < len(CHECKPOINTS):
            return CHECKPOINTS[self.checkpoint_index]
        if not self.approach_gate_passed:
            return LANDING_APPROACH_GATE
        return LANDING_TOUCHDOWN

    # --------------------------------------------------------
    # AUTOPILOT
    # --------------------------------------------------------

    def update_autopilot_request(self, state: ControllerState) -> None:
        if state.autopilot_request != self.last_autopilot_request:
            if state.autopilot_request:
                if self.airborne and not self.crashed and not self.mission_complete:
                    self.autopilot_active = True
                else:
                    self.autopilot_active = False
                    self.autopilot_rejected_until = time.monotonic() + 2.5
            else:
                self.autopilot_active = False

            self.last_autopilot_request = state.autopilot_request

        if not self.airborne or self.crashed or self.mission_complete:
            self.autopilot_active = False

    # --------------------------------------------------------
    # FLIGHT PHYSICS
    # --------------------------------------------------------

    def update_physics(self, state: ControllerState, dt: float) -> None:
        if self.crashed:
            self.speed *= max(0.0, 1.0 - dt * 1.2)
            self.rpm *= max(0.0, 1.0 - dt * 1.5)
            return

        if self.mission_complete:
            self.speed *= max(0.0, 1.0 - dt * 0.9)
            self.rpm *= max(0.0, 1.0 - dt * 1.2)
            return

        # Engine
        target_rpm = 700.0 + state.throttle * 48.0
        if state.throttle < 2:
            target_rpm = 650.0
        if self.fuel <= 0:
            target_rpm = 0.0

        self.rpm += (target_rpm - self.rpm) * min(1.0, dt * 3.5)

        if state.throttle > 0 and self.fuel > 0:
            fuel_use = 0.003 + state.throttle * 0.00012
            self.fuel = max(0.0, self.fuel - fuel_use * dt)

        pitch_command = state.pitch
        roll_command = state.roll

        rudder_command = 0.0
        if state.rudder_left:
            rudder_command -= 100.0
        if state.rudder_right:
            rudder_command += 100.0

        # Waypoint autopilot
        if self.autopilot_active:
            target = self.current_target()
            pos = self.aircraft.getPos(self.render)
            desired_heading = heading_between(pos, target)
            heading_error = shortest_angle(desired_heading, self.heading)

            roll_command = clamp(heading_error * 2.0, -55.0, 55.0)

            target_z = target.z
            if self.checkpoint_index >= len(CHECKPOINTS):
                # Gentle approach instead of diving at runway ground.
                if not self.approach_gate_passed:
                    target_z = LANDING_APPROACH_GATE.z
                else:
                    horizontal = distance2(pos, LANDING_TOUCHDOWN)
                    target_z = LANDING_TOUCHDOWN.z + clamp(horizontal * 0.10, 5.0, 45.0)

            pitch_command = clamp(
                (target_z - pos.z) * 0.8 - self.vertical_speed * 2.5,
                -35.0,
                35.0,
            )

        # Speed model
        effective_throttle = state.throttle if self.fuel > 0 else 0.0
        target_speed = effective_throttle * 0.84 - state.flaps * 0.28

        if not self.airborne:
            target_speed -= 4.0

        target_speed = max(0.0, target_speed)
        self.speed += (target_speed - self.speed) * min(1.0, dt * 1.8)

        authority = clamp(self.speed / 31.0, 0.12, 1.0)
        target_pitch = clamp(pitch_command, -100.0, 100.0) * 0.22
        target_bank = -clamp(roll_command, -100.0, 100.0) * 0.42

        self.pitch_angle += (target_pitch - self.pitch_angle) * min(1.0, dt * 3.0)
        self.bank_angle += (target_bank - self.bank_angle) * min(1.0, dt * 4.0)

        turn_rate = (-self.bank_angle * 0.10 + rudder_command * 0.018) * authority
        self.heading = (self.heading + turn_rate * dt * 18.0) % 360.0

        # Lift / vertical movement
        lift = math.sin(math.radians(self.pitch_angle)) * self.speed * 0.51
        flap_lift = state.flaps * 0.025 * clamp(self.speed / 30.0, 0.0, 1.5)
        natural_sink = 4.7 * (1.0 - self.speed / 20.0) if self.speed < 20 else 0.8
        target_vertical_speed = lift + flap_lift - natural_sink

        self.vertical_speed += (
            target_vertical_speed - self.vertical_speed
        ) * min(1.0, dt * 2.4)

        pos = self.aircraft.getPos(self.render)

        # Before takeoff, follow the actual sloping takeoff runway height.
        if not self.airborne:
            runway_ground = interpolate_segment_z(pos, TAKEOFF_START, TAKEOFF_END)
            if pos.z <= runway_ground + 0.15 and self.speed < 30:
                self.vertical_speed = min(0.0, self.vertical_speed)

        pos.z += self.vertical_speed * dt

        heading_radians = math.radians(self.heading)
        pos.x += math.sin(heading_radians) * self.speed * dt
        pos.y += math.cos(heading_radians) * self.speed * dt

        # Keep plane on the takeoff runway until it actually lifts.
        if not self.airborne:
            runway_ground = interpolate_segment_z(pos, TAKEOFF_START, TAKEOFF_END)
            if pos.z < runway_ground:
                pos.z = runway_ground
                self.vertical_speed = 0.0

            if pos.z > runway_ground + 5.5:
                self.airborne = True

        self.aircraft.setPos(pos)
        self.aircraft.setHpr(-self.heading, -self.pitch_angle, self.bank_angle)

        # Landing logic only near destination runway.
        if self.airborne and self.checkpoint_index >= len(CHECKPOINTS):
            self.handle_landing(state)

    def handle_landing(self, state: ControllerState) -> None:
        pos = self.aircraft.getPos(self.render)

        runway_distance = point_to_segment_distance_2d(
            pos,
            LANDING_START,
            LANDING_END,
        )

        near_destination = distance2(pos, LANDING_TOUCHDOWN) < 300.0
        at_ground = pos.z <= LANDING_TOUCHDOWN.z + 1.0

        if not (near_destination and runway_distance <= LANDING_RUNWAY_HALF_WIDTH and at_ground):
            return

        # Touch the runway surface.
        pos.z = LANDING_TOUCHDOWN.z
        self.aircraft.setPos(pos)

        aligned = abs(shortest_angle(self.landing_heading, self.heading)) < 24.0
        gentle = abs(self.vertical_speed) < 7.0 and abs(self.bank_angle) < 18.0
        configured = state.gear and state.flaps >= 20
        safe_speed = 16.0 <= self.speed <= 55.0

        if aligned and gentle and configured and safe_speed and self.approach_gate_passed:
            self.mission_complete = True
            self.airborne = False
            self.vertical_speed = 0.0
            self.success_until = time.monotonic() + 8.0
        elif abs(self.vertical_speed) > 10.0 or abs(self.bank_angle) > 30.0 or not state.gear:
            self.crashed = True
            self.airborne = False
            self.speed = 0.0
            self.vertical_speed = 0.0
        else:
            # A survivable but imperfect touchdown; keep rolling.
            self.vertical_speed = 0.0

    # --------------------------------------------------------
    # CAMERA
    # --------------------------------------------------------

    def change_camera(self) -> None:
        self.camera_mode = (self.camera_mode + 1) % 3

    def update_camera(self, state: ControllerState) -> None:
        if state.camera_counter != self.last_camera_counter:
            self.change_camera()
            self.last_camera_counter = state.camera_counter

        if state.centre_counter != self.last_centre_counter:
            self.camera_mode = 0
            self.last_centre_counter = state.centre_counter

        self.camera.reparentTo(self.aircraft)

        if self.camera_mode == 0:      # Chase
            self.camera.setPos(0, -30, 10)
            self.camera.setHpr(0, -10, 0)
        elif self.camera_mode == 1:    # Cockpit
            self.camera.setPos(0, 2.8, 2.1)
            self.camera.setHpr(0, 0, 0)
        else:                          # High chase
            self.camera.setPos(0, -46, 28)
            self.camera.setHpr(0, -24, 0)

    # --------------------------------------------------------
    # MISSION TEXT + WARNINGS
    # --------------------------------------------------------

    def altitude_agl(self) -> float:
        pos = self.aircraft.getPos(self.render)
        if distance2(pos, LANDING_TOUCHDOWN) < 500:
            return max(0.0, pos.z - LANDING_TOUCHDOWN.z)
        return max(0.0, pos.z - TAKEOFF_START.z)

    def mission_instruction(self, state: ControllerState) -> str:
        if self.crashed:
            return "CRASHED - PRESS R TO RESET"

        if self.mission_complete:
            return "MISSION COMPLETE - SAFE LANDING"

        if time.monotonic() < self.checkpoint_flash_until:
            return self.checkpoint_flash_text

        if self.fuel <= 0:
            return "ENGINE STOPPED - LAND IMMEDIATELY"

        if not self.airborne:
            if state.flaps != 10:
                return "SET FLAPS TO 10"
            if not state.gear:
                return "KEEP LANDING GEAR DOWN"
            if state.throttle < 90:
                return "THROTTLE ABOVE 90%"
            if self.speed < 34:
                return "BUILD TAKEOFF SPEED"
            return "PULL BACK GENTLY - TAKE OFF"

        if self.checkpoint_index < len(CHECKPOINTS):
            target = CHECKPOINTS[self.checkpoint_index]
            distance = distance3(self.aircraft.getPos(self.render), target)
            return f"FLY THROUGH CHECKPOINT {self.checkpoint_index + 1} - {distance:.0f} m"

        if not self.approach_gate_passed:
            if not state.gear:
                return "APPROACH: LOWER LANDING GEAR"
            if state.flaps < 20:
                return "APPROACH: SET FLAPS 20 OR 30"
            distance = distance3(self.aircraft.getPos(self.render), LANDING_APPROACH_GATE)
            return f"FLY THROUGH LANDING APPROACH GATE - {distance:.0f} m"

        pos = self.aircraft.getPos(self.render)
        distance = distance2(pos, LANDING_TOUCHDOWN)

        if not state.gear:
            return "GEAR DOWN NOW"
        if state.flaps < 20:
            return "FLAPS 20 OR 30"
        if abs(shortest_angle(self.landing_heading, self.heading)) > 20:
            return "ALIGN WITH LANDING RUNWAY"
        if self.speed > 55:
            return "REDUCE SPEED"
        if self.altitude_agl() > 18:
            return f"DESCEND GENTLY - TOUCHDOWN {distance:.0f} m"

        return "HOLD CENTRELINE - TOUCH DOWN"

    def warning_flags(self, state: ControllerState):
        altitude = self.altitude_agl()
        stall = self.airborne and self.speed < 24 and self.pitch_angle > 8
        overspeed = self.speed > 76
        low_fuel = self.fuel <= 15
        gear_warning = (
            self.airborne
            and self.checkpoint_index >= len(CHECKPOINTS)
            and distance2(self.aircraft.getPos(self.render), LANDING_TOUCHDOWN) < 550
            and altitude < 60
            and self.vertical_speed < -0.5
            and not state.gear
        )
        return stall, overspeed, low_fuel, gear_warning

    def warning_state(self, state: ControllerState):
        stall, overspeed, low_fuel, gear_warning = self.warning_flags(state)

        if self.crashed:
            return "CRASH", 3, 255, False, False, True
        if self.mission_complete and time.monotonic() < self.success_until:
            return "MISSION COMPLETE", 4, 130, True, False, False
        if time.monotonic() < self.checkpoint_flash_until:
            return "CHECKPOINT CLEARED", 1, 80, True, False, False
        if stall:
            return "STALL", 2, 255, False, False, True
        if gear_warning:
            return "GEAR NOT DOWN", 2, 180, False, True, True
        if overspeed:
            return "OVERSPEED", 2, 140, False, False, True
        if self.fuel <= 0:
            return "OUT OF FUEL", 3, 180, False, True, True
        if low_fuel:
            return "LOW FUEL", 1, 80, True, True, False

        vibration = int(
            clamp(
                self.speed * 0.7 if self.altitude_agl() < 2 else abs(self.bank_angle) * 0.75,
                0,
                60,
            )
        )

        if time.monotonic() < self.autopilot_rejected_until:
            return "AUTOPILOT UNAVAILABLE", 1, 40, False, True, False
        if self.autopilot_active:
            return "AUTOPILOT", 0, vibration, True, False, False
        if state.flaps > 0 or state.gear:
            return "CONFIGURATION ACTIVE", 0, vibration, True, True, False
        return "NORMAL", 0, vibration, True, False, False


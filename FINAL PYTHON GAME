def clamp(value: float, minimum: float, maximum: float) -> float:
    return max(minimum, min(maximum, value))


def safe_float(data: dict, key: str, default: float = 0.0) -> float:
    try:
        return float(data.get(key, default))
    except (TypeError, ValueError):
        return default


def safe_bool(data: dict, key: str, default: bool = False) -> bool:
    value = data.get(key, default)
    if isinstance(value, bool):
        return value
    try:
        return bool(int(value))
    except (TypeError, ValueError):
        return default


def parse_remote_packet(message: str) -> dict[str, str]:
    """Parse ESP32 packets of the form KEY=value;KEY=value;..."""
    result: dict[str, str] = {}

    for part in message.strip().split(";"):
        if "=" not in part:
            continue

        key, value = part.split("=", 1)
        result[key.strip()] = value.strip()

    return result


def field_float(data: dict[str, str], key: str, default: float = 0.0) -> float:
    try:
        return float(data.get(key, default))
    except (TypeError, ValueError):
        return default


def field_int(data: dict[str, str], key: str, default: int = 0) -> int:
    try:
        return int(float(data.get(key, default)))
    except (TypeError, ValueError):
        return default


def udp_receiver() -> None:
    """
    Receive the FINAL ESP32 remote protocol.

    ESP32 sends:
      ROLL=-1..1
      PITCH=-1..1
      THROTTLE=0..100
      RUDDER_L=0/1
      RUDDER_R=0/1
      GEAR=0/1
      FLAPS_DN_EVT=counter
      FLAPS_UP_EVT=counter
      CAM_EVT=counter
      AP_EVT=counter
      JOY_EVT=counter
    """

    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)

    try:
        sock.bind(("0.0.0.0", LISTEN_PORT))
    except OSError as error:
        print(f"Could not open UDP port {LISTEN_PORT}: {error}")
        return

    sock.settimeout(0.25)

    # Event counters survive packet loss because the ESP32 sends totals.
    last_flaps_down_event = 0
    last_flaps_up_event = 0
    current_flaps = 0

    print("\n========================================")
    print("AVIATION GAME NETWORK READY")
    print(f"ESP32 -> Python UDP {LISTEN_PORT}")
    print(f"Python -> ESP32 UDP {FEEDBACK_PORT}")
    print("REMOTE PROTOCOL: FINAL SEMICOLON FORMAT")
    print("Connect Mac Wi-Fi to: AVIATION_REMOTE")
    print("Password: fly12345")
    print("========================================\n")

    while network_running:
        try:
            payload, address = sock.recvfrom(4096)

            message = payload.decode("utf-8", errors="ignore").strip()

            if not message:
                continue

            data = parse_remote_packet(message)

            # Joystick is sent by your ESP32 as -1.0 .. +1.0.
            # The flight physics uses -100 .. +100.
            roll = clamp(
                field_float(data, "ROLL", 0.0) * 100.0,
                -100.0,
                100.0,
            )

            pitch = clamp(
                field_float(data, "PITCH", 0.0) * 100.0,
                -100.0,
                100.0,
            )

            throttle = clamp(
                field_float(data, "THROTTLE", 0.0),
                0.0,
                100.0,
            )

            rudder_left = field_int(data, "RUDDER_L", 0) != 0
            rudder_right = field_int(data, "RUDDER_R", 0) != 0
            gear = field_int(data, "GEAR", 0) != 0

            # ---------------------------------------------------
            # FLAPS
            # FLAPS_DN event = add flap angle: 0 -> 10 -> 20 -> 30
            # FLAPS_UP event = remove flap angle: 30 -> 20 -> 10 -> 0
            # ---------------------------------------------------

            flaps_down_event = field_int(
                data,
                "FLAPS_DN_EVT",
                last_flaps_down_event,
            )

            flaps_up_event = field_int(
                data,
                "FLAPS_UP_EVT",
                last_flaps_up_event,
            )

            # If ESP32 rebooted, its counters can reset to zero.
            if flaps_down_event < last_flaps_down_event:
                last_flaps_down_event = flaps_down_event

            if flaps_up_event < last_flaps_up_event:
                last_flaps_up_event = flaps_up_event

            down_delta = max(
                0,
                flaps_down_event - last_flaps_down_event,
            )

            up_delta = max(
                0,
                flaps_up_event - last_flaps_up_event,
            )

            if down_delta:
                current_flaps = int(
                    clamp(
                        current_flaps + 10 * down_delta,
                        0,
                        30,
                    )
                )

            if up_delta:
                current_flaps = int(
                    clamp(
                        current_flaps - 10 * up_delta,
                        0,
                        30,
                    )
                )

            last_flaps_down_event = flaps_down_event
            last_flaps_up_event = flaps_up_event

            # Camera event total can go directly into the existing
            # camera-counter logic.
            camera_event = field_int(data, "CAM_EVT", 0)

            # Joystick press returns chase camera to centre.
            joystick_event = field_int(data, "JOY_EVT", 0)

            # AP_EVT is a press counter. Odd = requested ON,
            # even = requested OFF.
            autopilot_event = field_int(data, "AP_EVT", 0)
            autopilot_request = (autopilot_event % 2) == 1

            with controller_lock:
                controller.roll = roll
                controller.pitch = pitch
                controller.throttle = throttle

                controller.rudder_left = rudder_left
                controller.rudder_right = rudder_right

                controller.flaps = current_flaps
                controller.gear = gear

                controller.camera_counter = camera_event
                controller.centre_counter = joystick_event
                controller.autopilot_request = autopilot_request

                controller.sender_ip = address[0]
                controller.last_packet_time = time.monotonic()

        except socket.timeout:
            continue

        except OSError:
            continue

        except Exception as error:
            # Keep the game alive even if one malformed UDP packet arrives.
            print("Remote packet warning:", error)
            continue

    sock.close()


threading.Thread(target=udp_receiver, daemon=True).start()


def controller_snapshot() -> ControllerState:
    with controller_lock:
        return ControllerState(**controller.__dict__)


def controller_connected(state: ControllerState) -> bool:
    return (
        state.sender_ip is not None
        and time.monotonic() - state.last_packet_time < CONTROLLER_TIMEOUT
    )


def shortest_angle(target: float, current: float) -> float:
    return (target - current + 180.0) % 360.0 - 180.0


def heading_between(a: Point3, b: Point3) -> float:
    """Heading convention: 0 = +Y, 90 = +X, 180 = -Y, 270 = -X."""
    dx = b.x - a.x
    dy = b.y - a.y
    return math.degrees(math.atan2(dx, dy)) % 360.0


def distance3(a: Point3, b: Point3) -> float:
    dx = a.x - b.x
    dy = a.y - b.y
    dz = a.z - b.z
    return math.sqrt(dx * dx + dy * dy + dz * dz)


def distance2(a: Point3, b: Point3) -> float:
    dx = a.x - b.x
    dy = a.y - b.y
    return math.sqrt(dx * dx + dy * dy)


def point_to_segment_distance_2d(p: Point3, a: Point3, b: Point3) -> float:
    abx = b.x - a.x
    aby = b.y - a.y
    apx = p.x - a.x
    apy = p.y - a.y
    denom = abx * abx + aby * aby

    if denom <= 1e-9:
        return math.sqrt(apx * apx + apy * apy)

    t = clamp((apx * abx + apy * aby) / denom, 0.0, 1.0)
    cx = a.x + t * abx
    cy = a.y + t * aby
    dx = p.x - cx
    dy = p.y - cy
    return math.sqrt(dx * dx + dy * dy)


def interpolate_segment_z(p: Point3, a: Point3, b: Point3) -> float:
    abx = b.x - a.x
    aby = b.y - a.y
    apx = p.x - a.x
    apy = p.y - a.y
    denom = abx * abx + aby * aby

    if denom <= 1e-9:
        return a.z

    t = clamp((apx * abx + apy * aby) / denom, 0.0, 1.0)
    return a.z + (b.z - a.z) * t


def make_ring(parent, name: str, radius: float, position: Point3, look_at: Point3):
    line = LineSegs(name)
    line.setThickness(7.0)
    line.setColor(1.0, 0.82, 0.05, 1.0)

    segments = 64
    for i in range(segments + 1):
        angle = 2.0 * math.pi * i / segments
        x = radius * math.cos(angle)
        z = radius * math.sin(angle)
        if i == 0:
            line.moveTo(x, 0, z)
        else:
            line.drawTo(x, 0, z)

    ring = parent.attachNewNode(line.create())
    ring.setPos(position)
    ring.lookAt(look_at)
    ring.setLightOff()
    return ring



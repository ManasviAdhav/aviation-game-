#include <WiFi.h>
#include <WebServer.h>
#include <ESP32Servo.h>

// Servo connection
#define SERVO_PIN 7

Servo servoMotor;

// ESP32 Wi-Fi hotspot
const char* ssid = "ESP32_SERVO";
const char* password = "12345678";

WebServer server(80);

int servoAngle = 90;

const char webpage[] PROGMEM = R"rawliteral(
<!DOCTYPE html>
<html>

<head>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <style>
    body {
      font-family: Arial;
      background: #111;
      color: white;
      text-align: center;
      margin: 20px;
    }

    button {
      width: 105px;
      height: 50px;
      font-size: 17px;
      margin: 6px;
      border: none;
      border-radius: 10px;
      color: white;
      background: #0066ff;
      cursor: pointer;
    }

    .centre {
      background: #00aa66;
    }

    .angleDisplay {
      font-size: 35px;
      margin: 20px;
    }

    .slider {
      width: 90%;
      max-width: 400px;
    }

    .servoVisual {
      width: 150px;
      height: 150px;
      border: 4px solid white;
      border-radius: 50%;
      margin: 25px auto;
      position: relative;
    }

    .arm {
      width: 65px;
      height: 8px;
      background: #ffcc00;
      border-radius: 5px;
      position: absolute;
      left: 75px;
      top: 71px;
      transform-origin: left center;
      transform: rotate(0deg);
    }
  </style>
</head>

<body>

  <h2>ESP32 Servo Controller</h2>

  <div class="servoVisual">
    <div class="arm" id="arm"></div>
  </div>

  <div class="angleDisplay">
    <span id="angleText">90</span>&deg;
  </div>

  <button onclick="setAngle(0)">0&deg;</button>
  <button class="centre" onclick="setAngle(90)">90&deg;</button>
  <button onclick="setAngle(180)">180&deg;</button>

  <br><br>

  <input
    type="range"
    min="0"
    max="180"
    value="90"
    id="servoSlider"
    class="slider"
    oninput="updateServo(this.value)"
  >

  <script>
    let requestTimer;

    function setAngle(angle) {
      document.getElementById("servoSlider").value = angle;
      updateServo(angle);
    }

    function updateServo(angle) {
      document.getElementById("angleText").innerHTML = angle;

      // Convert 0–180 servo angle into visual rotation
      let visualAngle = angle - 90;

      document.getElementById("arm").style.transform =
        "rotate(" + visualAngle + "deg)";

      // Avoid sending excessive requests while moving slider
      clearTimeout(requestTimer);

      requestTimer = setTimeout(function() {
        fetch("/servo?angle=" + angle);
      }, 40);
    }

    updateServo(90);
  </script>

</body>
</html>
)rawliteral";


void handleRoot() {
  server.send_P(200, "text/html", webpage);
}


void handleServo() {
  if (!server.hasArg("angle")) {
    server.send(400, "text/plain", "Angle missing");
    return;
  }

  int requestedAngle = server.arg("angle").toInt();

  // Keep angle inside safe servo range
  requestedAngle = constrain(requestedAngle, 0, 180);

  servoAngle = requestedAngle;
  servoMotor.write(servoAngle);

  Serial.print("Servo angle: ");
  Serial.print(servoAngle);
  Serial.println(" degrees");

  server.send(200, "text/plain", "Servo moved");
}


void setup() {
  Serial.begin(115200);
  delay(500);

  // Standard SG90 PWM frequency
  servoMotor.setPeriodHertz(50);

  // Attach servo with common SG90 pulse limits
  servoMotor.attach(SERVO_PIN, 500, 2400);

  // Start servo in the centre
  servoMotor.write(servoAngle);
  delay(500);

  // Start ESP32 Wi-Fi hotspot
  WiFi.mode(WIFI_AP);

  if (!WiFi.softAP(ssid, password)) {
    Serial.println("Wi-Fi hotspot failed!");

    while (true) {
      delay(1000);
    }
  }

  Serial.println();
  Serial.println("Wi-Fi started");

  Serial.print("Wi-Fi name: ");
  Serial.println(ssid);

  Serial.print("IP address: ");
  Serial.println(WiFi.softAPIP());

  server.on("/", handleRoot);
  server.on("/servo", handleServo);

  server.begin();

  Serial.println("Web server started");
  Serial.println("Open 192.168.4.1 in your browser");
}


void loop() {
  server.handleClient();
}

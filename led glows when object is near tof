#include <Wire.h>

#define TOF_SDA_PIN 6
#define TOF_SCL_PIN 5

TwoWire TOFWire = TwoWire(1);

void setup() {
  Serial.begin(115200);
  delay(1000);

  TOFWire.begin(TOF_SDA_PIN, TOF_SCL_PIN, 100000);

  Serial.println("Scanning ToF connection...");
}

void loop() {
  int devices = 0;

  for (uint8_t address = 1; address < 127; address++) {
    TOFWire.beginTransmission(address);
    uint8_t error = TOFWire.endTransmission();

    if (error == 0) {
      Serial.print("Device detected at 0x");

      if (address < 16) {
        Serial.print("0");
      }

      Serial.println(address, HEX);
      devices++;
    }
  }

  if (devices == 0) {
    Serial.println("No ToF sensor detected!");
  }

  Serial.println("----------------");
  delay(3000);
}

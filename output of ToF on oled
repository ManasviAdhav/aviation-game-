#include <Wire.h>
#include <VL53L0X.h>

// Connections
#define TOF_SDA_PIN 6
#define TOF_SCL_PIN 5
#define LED_PIN 4

// Distance limits
#define LED_ON_DISTANCE_MM  200   // LED ON at 20 cm
#define LED_OFF_DISTANCE_MM 230   // LED OFF at 23 cm

VL53L0X sensor;

bool ledState = false;

void setup() {
  Serial.begin(115200);
  delay(1000);

  pinMode(LED_PIN, OUTPUT);
  digitalWrite(LED_PIN, LOW);

  // Start I2C
  // SDA = GPIO 6
  // SCL = GPIO 5
  Wire.begin(TOF_SDA_PIN, TOF_SCL_PIN, 100000);

  delay(500);

  Serial.println();
  Serial.println("Starting VL53L0X ToF sensor...");

  sensor.setBus(&Wire);
  sensor.setTimeout(500);

  // Initialize VL53L0X
  if (!sensor.init()) {
    Serial.println("ERROR: VL53L0X initialization failed.");
    Serial.println("Check power, SDA, SCL and XSHUT.");

    while (true) {
      digitalWrite(LED_PIN, LOW);
      delay(1000);
    }
  }

  Serial.println("VL53L0X initialized successfully!");

  // Start continuous distance measurement
  sensor.startContinuous(50);

  Serial.println("Sensor ready.");
  Serial.println("----------------------------");
}

void loop() {
  // Read distance in millimetres
  uint16_t distanceMM =
    sensor.readRangeContinuousMillimeters();

  // Check sensor timeout
  if (sensor.timeoutOccurred()) {
    ledState = false;
    digitalWrite(LED_PIN, LOW);

    Serial.println("Sensor timeout | LED: OFF");
    delay(100);
    return;
  }

  float distanceCM = distanceMM / 10.0;

  // Object near: turn LED on
  if (distanceMM <= LED_ON_DISTANCE_MM) {
    ledState = true;
  }

  // Object far: turn LED off
  else if (distanceMM >= LED_OFF_DISTANCE_MM) {
    ledState = false;
  }

  digitalWrite(
    LED_PIN,
    ledState ? HIGH : LOW
  );

  Serial.print("Distance: ");
  Serial.print(distanceCM, 1);
  Serial.print(" cm | LED: ");
  Serial.println(ledState ? "ON" : "OFF");

  delay(100);
}
